#!/bin/bash
# obsidian-lazy-commit-commit
#
# The per-tick script. Called by launchd (via brew services or the
# git-clone plist) and by the obsidian-lazy-commit default entry.
#
# Resolves the actual commit.sh, which lives:
#   - In a brew install: at $HOMEBREW_PREFIX/share/obsidian-lazy-commit/commit.sh
#   - In a git-clone install: at $REPO_ROOT/commit.sh (one level up from bin/)

set -euo pipefail

COMMIT_SH=""

# If HOMEBREW_PREFIX is set (brew-installed launchd will set it), prefer that.
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -f "$HOMEBREW_PREFIX/share/obsidian-lazy-commit/commit.sh" ]; then
  COMMIT_SH="$HOMEBREW_PREFIX/share/obsidian-lazy-commit/commit.sh"
fi

# Otherwise try the well-known Homebrew paths. This is what the wrapper does
# when invoked from the user's interactive shell (where HOMEBREW_PREFIX is
# not exported).
if [ -z "$COMMIT_SH" ]; then
  for prefix in /opt/homebrew /usr/local; do
    if [ -f "$prefix/share/obsidian-lazy-commit/commit.sh" ]; then
      COMMIT_SH="$prefix/share/obsidian-lazy-commit/commit.sh"
      break
    fi
  done
fi

# Fall back to the git-clone layout: ../commit.sh relative to this script.
if [ -z "$COMMIT_SH" ]; then
  SCRIPT_BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
  if [ -f "$SCRIPT_BIN_DIR/../commit.sh" ]; then
    COMMIT_SH="$SCRIPT_BIN_DIR/../commit.sh"
  elif [ -f "$SCRIPT_BIN_DIR/commit.sh" ]; then
    COMMIT_SH="$SCRIPT_BIN_DIR/commit.sh"
  fi
fi

if [ -z "$COMMIT_SH" ]; then
  echo "obsidian-lazy-commit-commit: cannot locate commit.sh" >&2
  echo "Tried:" >&2
  echo "  \$HOMEBREW_PREFIX/share/obsidian-lazy-commit/commit.sh" >&2
  echo "  /opt/homebrew/share/obsidian-lazy-commit/commit.sh" >&2
  echo "  /usr/local/share/obsidian-lazy-commit/commit.sh" >&2
  echo "  <script-dir>/../commit.sh" >&2
  echo "  <script-dir>/commit.sh" >&2
  exit 1
fi

exec "$COMMIT_SH"
