#!/bin/bash
# obsidian-lazy-commit-setup
#
# Interactive first-time setup. Writes ~/.config/obsidian-lazy-commit/config.toml
# with the user's vault list and schedule, and either:
#   - loads the launchd plist directly (git-clone install), or
#   - tells the user to run `brew services start obsidian-lazy-commit`
#     (Homebrew install).
#
# Re-runs are safe: existing configs are detected and the user is asked
# whether to keep the existing vault list.

set -euo pipefail

SCHEDULE_DEFAULT=3600
SENTINEL_SCHEDULE="$SCHEDULE_DEFAULT"
REPO_DIR_DEFAULT="$HOME/.local/share/obsidian-lazy-commit"

# Detect Homebrew install by our own location: the brew formula installs this
# script into the formula's bin directory.
BREW_INSTALL=0
case "$0" in
  /opt/homebrew/bin/*|/usr/local/bin/*|/home/linuxbrew/.linuxbrew/bin/*)
    BREW_INSTALL=1
    ;;
esac

log() { echo "[setup] $1"; }
err() { echo "[setup] ERROR: $1" >&2; }

# --- Prereqs -------------------------------------------------------------------
if ! command -v git &>/dev/null; then
  err "git is required but not found in PATH."
  exit 1
fi
if ! command -v python3 &>/dev/null; then
  err "python3 is required to parse the TOML config."
  exit 1
fi
# afm-cli is optional: it generates natural-language commit messages via
# on-device Apple Intelligence. Without it, commit.sh falls back to a
# timestamp subject, so this is a warning, not a hard requirement.
if ! command -v afm-cli &>/dev/null; then
  log "afm-cli not found — commit messages will fall back to 'auto-sync: <timestamp>'."
  log "Install later with: brew install creevekcz/tap/afm-cli"
fi

# The commit script lives next to this file in a git-clone install, or in
# <brew prefix>/libexec/ in a brew install. Only the git-clone path needs a
# concrete location (brew services builds the plist from the formula itself).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLIST_DST="$HOME/Library/LaunchAgents/com.user.obsidian-lazy-commit.plist"
if [ "$BREW_INSTALL" -eq 1 ]; then
  COMMIT_SCRIPT=""
else
  COMMIT_SCRIPT="$SCRIPT_DIR/../commit.sh"
  [ -f "$COMMIT_SCRIPT" ] || COMMIT_SCRIPT="$SCRIPT_DIR/commit.sh"
fi

CONFIG_DIR="$HOME/.config/obsidian-lazy-commit"
CONFIG_FILE="$CONFIG_DIR/config.toml"

mkdir -p "$CONFIG_DIR"

# --- Collect / refresh vault list ----------------------------------------------
declare -a EXISTING_NAMES=()
declare -a EXISTING_PATHS=()
declare -a EXISTING_REMOTES=()
declare -a EXISTING_BRANCHES=()
declare -a EXISTING_PULLS=()
EXISTING_MODE=""
EXISTING_SCHEDULE=""

if [ -f "$CONFIG_FILE" ]; then
  if EXISTING=$(CONFIG_FILE_PATH="$CONFIG_FILE" python3 - <<'PY' 2>/dev/null
import os, tomllib
with open(os.environ["CONFIG_FILE_PATH"], "rb") as f:
    data = tomllib.load(f)
print(f"__MODE__={data.get('mode', 'interval')}")
print(f"__SCHEDULE__={data.get('schedule_seconds', 3600)}")
for v in (data.get("vaults") or []):
    print(f"{v.get('name','')}|{v.get('path','')}|{v.get('remote','')}|{v.get('branch','main')}|{1 if v.get('pull_before_push') else 0}")
PY
  ); then
    while IFS= read -r line; do
      case "$line" in
        __MODE__=*) EXISTING_MODE="${line#__MODE__=}" ;;
        __SCHEDULE__=*) EXISTING_SCHEDULE="${line#__SCHEDULE__=}" ;;
        *)
          IFS='|' read -r n p r b pull <<< "$line"
          EXISTING_NAMES+=("$n")
          EXISTING_PATHS+=("$p")
          EXISTING_REMOTES+=("$r")
          EXISTING_BRANCHES+=("$b")
          EXISTING_PULLS+=("$pull")
          ;;
      esac
    done <<< "$EXISTING"
  fi
  log "Existing config found with ${#EXISTING_NAMES[@]} vault(s)."
  read -r -p "[setup] Keep the existing vault list? [Y/n] " KEEP_ANSWER
  KEEP_ANSWER="${KEEP_ANSWER:-Y}"
else
  KEEP_ANSWER="n"
fi

declare -a VAULT_NAMES=()
declare -a VAULT_PATHS=()
declare -a VAULT_REMOTES=()
declare -a VAULT_BRANCHES=()
declare -a VAULT_PULLS=()

if [[ "$KEEP_ANSWER" =~ ^[Yy]$ ]] && [ "${#EXISTING_NAMES[@]}" -gt 0 ]; then
  VAULT_NAMES=("${EXISTING_NAMES[@]}")
  VAULT_PATHS=("${EXISTING_PATHS[@]}")
  VAULT_REMOTES=("${EXISTING_REMOTES[@]}")
  VAULT_BRANCHES=("${EXISTING_BRANCHES[@]}")
  VAULT_PULLS=("${EXISTING_PULLS[@]}")
else
  echo
  log "Add vaults. Enter an empty line at the path prompt to finish."
  i=0
  while :; do
    i=$((i+1))
    read -r -p "[setup] Path to vault #$i (empty to finish): " PATH_INPUT
    if [ -z "$PATH_INPUT" ]; then
      break
    fi
    if [ ! -d "$PATH_INPUT" ]; then
      read -r -p "[setup] Path does not exist. Create '$PATH_INPUT'? [y/N] " CREATE_ANSWER
      if [[ "$CREATE_ANSWER" =~ ^[Yy]$ ]]; then
        mkdir -p "$PATH_INPUT"
        log "Created $PATH_INPUT"
      else
        log "Skipped. Re-enter this vault or pick a different path."
        i=$((i-1))
        continue
      fi
    fi
    PATH_ABS="$(cd "$PATH_INPUT" && pwd)"

    # Derive the vault name from the folder name (sanitized for log lines);
    # fall back to an indexed name on empty or duplicate results.
    default_name="$(basename "$PATH_ABS" | tr -cd 'A-Za-z0-9_-')"
    if [ -z "$default_name" ]; then
      default_name="vault${i}"
    fi
    NAME_INPUT="$default_name"
    dup=0
    for existing in "${VAULT_NAMES[@]:-}"; do
      if [ "$existing" = "$NAME_INPUT" ]; then
        dup=1
        break
      fi
    done
    if [ "$dup" -eq 1 ]; then
      NAME_INPUT="vault${i}"
    fi

    read -r -p "[setup] Git remote URL for '$NAME_INPUT' (empty = local only): " REMOTE_INPUT

    VAULT_NAMES+=("$NAME_INPUT")
    VAULT_PATHS+=("$PATH_ABS")
    VAULT_REMOTES+=("$REMOTE_INPUT")
    VAULT_BRANCHES+=("main")
    VAULT_PULLS+=("0")
    log "Added vault '$NAME_INPUT' -> $PATH_ABS"
    echo
  done
fi

if [ "${#VAULT_NAMES[@]}" -eq 0 ]; then
  err "at least one vault is required."
  exit 1
fi

# Optional trigger mode: interval (StartInterval, current behavior) or watch
# (WatchPaths, fires on filesystem changes, debounced in commit.sh).
echo
MODE_DEFAULT="interval"
read -r -p "[setup] Trigger mode (interval|watch) [default: ${EXISTING_MODE:-$MODE_DEFAULT}]: " MODE_INPUT
MODE="${MODE_INPUT:-${EXISTING_MODE:-$MODE_DEFAULT}}"
case "$MODE" in
  interval|watch) ;;
  *) err "mode must be 'interval' or 'watch'."; exit 1 ;;
esac

# Optional schedule override (interval mode only; watch mode ignores it).
echo
if [ "$MODE" = "interval" ]; then
  read -r -p "[setup] Schedule in seconds (default: ${EXISTING_SCHEDULE:-$SCHEDULE_DEFAULT}): " SCHEDULE_INPUT
  SCHEDULE_INPUT="${SCHEDULE_INPUT:-${EXISTING_SCHEDULE:-$SCHEDULE_DEFAULT}}"
  if ! [[ "$SCHEDULE_INPUT" =~ ^[0-9]+$ ]] || [ "$SCHEDULE_INPUT" -lt 60 ]; then
    err "schedule must be an integer >= 60."
    exit 1
  fi
  SENTINEL_SCHEDULE="$SCHEDULE_INPUT"
else
  SCHEDULE_INPUT="${EXISTING_SCHEDULE:-$SCHEDULE_DEFAULT}"
  SENTINEL_SCHEDULE=""
fi

# --- Write the TOML config -----------------------------------------------------
{
  echo "# Obsidian lazy commit configuration"
  echo "# One [[vaults]] entry per folder you want auto-committed and pushed."
  echo "# name must be unique and is used in log lines."
  echo "# remote may be empty (commits will stay local)."
  echo "# branch defaults to \"main\" if omitted."
  echo "# mode: \"interval\" (StartInterval) or \"watch\" (WatchPaths, debounced)."
  echo "# pull_before_push: run 'git pull --rebase' before push (multi-machine vaults)."
  echo "mode = \"$MODE\""
  echo "schedule_seconds = $SCHEDULE_INPUT"
  echo
  for i in "${!VAULT_NAMES[@]}"; do
    n="${VAULT_NAMES[$i]}"
    p="${VAULT_PATHS[$i]}"
    r="${VAULT_REMOTES[$i]}"
    b="${VAULT_BRANCHES[$i]}"
    pull="${VAULT_PULLS[$i]:-0}"
    echo "[[vaults]]"
    echo "name = \"$n\""
    echo "path = \"$p\""
    if [ -n "$r" ]; then
      echo "remote = \"$r\""
    fi
    if [ -n "$b" ] && [ "$b" != "main" ]; then
      echo "branch = \"$b\""
    fi
    if [ "$pull" -eq 1 ]; then
      echo "pull_before_push = true"
    fi
    echo
  done
} > "$CONFIG_FILE"

log "Wrote config to $CONFIG_FILE with ${#VAULT_NAMES[@]} vault(s)."

# --- Init / validate git per vault --------------------------------------------
DEFAULT_GITIGNORE='.DS_Store

.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

public/
.quartz-cache/

node_modules/
'

for i in "${!VAULT_NAMES[@]}"; do
  n="${VAULT_NAMES[$i]}"
  p="${VAULT_PATHS[$i]}"
  r="${VAULT_REMOTES[$i]}"
  b="${VAULT_BRANCHES[$i]}"

  if [ ! -d "$p/.git" ]; then
    log "[$n] No git repo in $p, initializing (branch=$b)..."
    if ! (cd "$p" && git init -b "$b" 2>/dev/null) ; then
      (cd "$p" && git init >/dev/null 2>&1) || true
      (cd "$p" && git checkout -B "$b" >/dev/null 2>&1) || true
    fi
  fi
  if [ -n "$r" ]; then
    existing="$(cd "$p" && git remote get-url origin 2>/dev/null || true)"
    if [ -z "$existing" ]; then
      (cd "$p" && git remote add origin "$r" 2>/dev/null) || true
      log "[$n] Added origin -> $r"
    elif [ "$existing" != "$r" ]; then
      log "[$n] NOTE: existing origin '$existing' differs from configured '$r'."
      log "[$n]   commit.sh will warn and skip push until you reconcile."
      log "[$n]   To accept the new URL: (cd '$p' && git remote set-url origin '$r')"
    else
      log "[$n] Origin already set to $r"
    fi
  fi

  # Scaffold a default .gitignore so `git add -A` stays clean (no .DS_Store,
  # .obsidian/workspace*.json, .trash/, node_modules/, Quartz build output).
  if [ ! -e "$p/.gitignore" ]; then
    read -r -p "[setup] No .gitignore found in '$p'. Add the recommended Obsidian .gitignore? [Y/n] " GI_ANSWER
    GI_ANSWER="${GI_ANSWER:-Y}"
    if [[ "$GI_ANSWER" =~ ^[Yy]$ ]]; then
      printf '%s' "$DEFAULT_GITIGNORE" > "$p/.gitignore"
      log "[$n] Created $p/.gitignore"
    fi
  elif [ ! -s "$p/.gitignore" ]; then
    printf '%s' "$DEFAULT_GITIGNORE" > "$p/.gitignore"
    log "[$n] .gitignore was empty — wrote recommended content."
  elif ! grep -q '^\.DS_Store$' "$p/.gitignore"; then
    read -r -p "[setup] '$p/.gitignore' exists but lacks common Obsidian patterns. Append them? [Y/n] " GI_APPEND
    GI_APPEND="${GI_APPEND:-Y}"
    if [[ "$GI_APPEND" =~ ^[Yy]$ ]]; then
      {
        printf '\n# Added by obsidian-lazy-commit-setup\n'
        printf '%s' "$DEFAULT_GITIGNORE"
      } >> "$p/.gitignore"
      log "[$n] Appended recommended patterns to $p/.gitignore"
    fi
  fi
done

# --- Load the launchd job ------------------------------------------------------
if [ "$BREW_INSTALL" -eq 1 ]; then
  log "Homebrew install detected — skipping plist install."
  log "To enable the launchd job, run:"
  log "  brew services start obsidian-lazy-commit"
  log "To stop it:"
  log "  brew services stop obsidian-lazy-commit"
  log "To see status:"
  log "  brew services info obsidian-lazy-commit"
  exit 0
fi

# Git-clone install: do the plist install manually. Generate the plist inline
# so interval (StartInterval) and watch (WatchPaths) modes both produce a
# valid launchd job.
mkdir -p "$(dirname "$PLIST_DST")"
{
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.obsidian-lazy-commit</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OBSIDIAN_LAZY_COMMIT_CONFIG_DIR</key>
        <string>$CONFIG_DIR</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>$COMMIT_SCRIPT</string>
    </array>
EOF
  if [ "$MODE" = "watch" ]; then
    echo "    <key>WatchPaths</key>"
    echo "    <array>"
    for wp in "${VAULT_PATHS[@]}"; do
      if [ ! -d "$wp" ]; then
        err "vault path '$wp' does not exist — cannot use it as a WatchPath. Aborting."
        exit 1
      fi
      echo "        <string>$wp</string>"
    done
    echo "    </array>"
  else
    echo "    <key>StartInterval</key>"
    echo "    <integer>$SCHEDULE_INPUT</integer>"
  fi
  cat <<EOF
    <key>StandardOutPath</key>
    <string>/tmp/obsidian-lazy-commit.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/obsidian-lazy-commit.err</string>
</dict>
</plist>
EOF
} > "$PLIST_DST"

if ! plutil -lint "$PLIST_DST" >/dev/null 2>&1; then
  err "generated plist failed plutil -lint. Aborting."
  exit 1
fi
log "Installed plist to $PLIST_DST (commit.sh=$COMMIT_SCRIPT, mode=$MODE${SENTINEL_SCHEDULE:+, every ${SENTINEL_SCHEDULE}s})"

UID_NUM="$(id -u)"
launchctl bootout "gui/$UID_NUM" "$PLIST_DST" 2>/dev/null || true
launchctl bootstrap "gui/$UID_NUM" "$PLIST_DST"
launchctl enable "gui/$UID_NUM/com.user.obsidian-lazy-commit" 2>/dev/null || true
launchctl kickstart -k "gui/$UID_NUM/com.user.obsidian-lazy-commit" 2>/dev/null || true
log "Loaded launchd job: com.user.obsidian-lazy-commit"

log "Done. Logs: /tmp/obsidian-lazy-commit.{log,err}"
