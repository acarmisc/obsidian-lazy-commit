#!/bin/bash
# obsidian-lazy-commit
#
# Default entry point. If no config exists, this is a friendly pointer to
# the setup command. If a config exists, this runs the per-tick commit
# immediately (useful for manual kicks).
#
# Resolves commit.sh for both install layouts:
#   - brew:   <prefix>/libexec/commit.sh   (bin -> libexec are siblings)
#   - git-clone: <repo>/bin/../commit.sh

set -euo pipefail

CONFIG_DIR="${OBSIDIAN_LAZY_COMMIT_CONFIG_DIR:-$HOME/.config/obsidian-lazy-commit}"
CONFIG_FILE="$CONFIG_DIR/config.toml"

if [ ! -f "$CONFIG_FILE" ]; then
  echo "obsidian-lazy-commit: no config found at $CONFIG_FILE"
  echo "Run 'obsidian-lazy-commit-setup' first to configure vaults and the schedule."
  exit 1
fi

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
for candidate in "$BIN_DIR/../libexec/commit.sh" "$BIN_DIR/../commit.sh" "$BIN_DIR/commit.sh"; do
  if [ -f "$candidate" ]; then
    exec "$candidate"
  fi
done

echo "obsidian-lazy-commit: cannot locate commit.sh (tried libexec and repo root)" >&2
exit 1